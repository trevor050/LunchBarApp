# Copy this file to one of the supported locations and fill in your school's data.
# Supported keys:
# - NUTRISLICE_ORIGIN: Base domain for your district (e.g. https://district.api.nutrislice.com)
# - NUTRISLICE_SCHOOL_SLUG: Slug for the school (check Nutrislice URL path)
# - NUTRISLICE_MENU_TYPE: Menu type slug (e.g. lunch, breakfast)

NUTRISLICE_ORIGIN="https://your-district.api.nutrislice.com"
NUTRISLICE_SCHOOL_SLUG="your-school-slug"
NUTRISLICE_MENU_TYPE="lunch"
